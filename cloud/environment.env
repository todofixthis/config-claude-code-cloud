# Paste this file's content, verbatim, into the cloud environment's
# "Environment variables" field at claude.ai/code.
#
# .env format: one KEY=value per line. No secrets — cloud environments have
# no dedicated secrets store, and anyone with access to this environment
# can read these values.

# Trust the OS CA bundle rather than each tool's own bundled one. Harmless
# if the session's egress proxy doesn't do TLS interception; needed if it
# does (uv and Python's requests/certifi otherwise ship their own CA store
# and would fail TLS validation against an intercepting proxy).
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
UV_SYSTEM_CERTS=1

# The session's own profile script sets UV_NATIVE_TLS=true when the variable
# is empty, and uv warns on every run that the name is deprecated. A value
# already present is left alone, and uv still trusts SSL_CERT_FILE, which the
# proxy setup exports, so `false` silences the warning without losing TLS.
UV_NATIVE_TLS=false

# Deliberately NOT set:
# - GH_TOKEN / GITHUB_TOKEN: leave unset so the built-in GitHub proxy
#   authenticates `gh` and the GitHub tools for you (shows up as the
#   placeholder "proxy-injected" rather than a real token). Only set one of
#   these yourself, with a narrowly-scoped PAT, if you hit something the
#   proxy doesn't cover (e.g. `gh release`, `gh workflow run`, or a GraphQL
#   query the proxy blocks) — and remember it's then plaintext-visible to
#   anyone using this environment.
# - Anything GPG/SSH/PyPI-related: deliberately out of scope for cloud
#   sessions — see README.md.
